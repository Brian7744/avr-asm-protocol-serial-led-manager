                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Aplicacion2.asm
                                 ;
                                 ; Created: 17/3/2026 11:30:35
                                 ; Author : brian
                                 ;
                                 #include <m328pdef.inc>
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;**************************** Igualdades **************************************
                                 
                                 ; Etiquetas para los pines
                                 .equ    LEDBUILTIN  = PB5
                                 .equ    LED1        = PB0
                                 .equ    LED2        = PB1
                                 .equ    LED3        = PB2
                                 .equ    LED4        = PB3
                                 .equ    SW1         = PD2
                                 .equ    SW2         = PD3
                                 .equ    SW3         = PD4
                                 .equ    SW4         = PD5
                                 
                                 .equ    STATE_IDLE      = 0
                                 .equ    STATE_UP        = 1
                                 .equ    STATE_DOWN      = 2
                                 .equ    STATE_COUNTER   = 3
                                 
                                 ; Bits en GPIOR0
                                 .equ    BIT_1MS         = 0
                                 .equ    BIT_100MS       = 1
                                 
                                 ; Timer1
                                 .equ    OCR1A_VAL       = 249
                                 
                                 ; Heartbeat
                                 .equ    HB_PERIOD       = 30
                                 .equ    SW3_LIMIT       = 2000
                                 
                                 ; UART — 115200 baud @ 16MHz con U2X0=1
                                 .equ    UBRR_VAL        = 16
                                 
                                 ; Protocolo 8 bytes ASCII: S CMD P1 P2 P3 CHK_H CHK_L W
                                 .equ    PROTO_HEADER    = 'S'
                                 .equ    PROTO_TAIL      = 'W'
                                 .equ    PROTO_LEN       = 8
                                 
                                 .equ    CMD_START_UP        = 'U'
                                 .equ    CMD_START_DOWN      = 'D'
                                 .equ    CMD_STOP            = 'S'
                                 .equ    CMD_START_COUNTER   = 'C'
                                 .equ    CMD_STOP_COUNTER    = 'X'
                                 .equ    CMD_LED_ON          = 'L'
                                 .equ    CMD_LED_OFF         = 'F'
                                 .equ    CMD_ALL_OFF         = 'A'
                                 .equ    CMD_SET_TIME        = 'T'
                                 
                                 ;****************** definiciones - nombres simbolicos *************************
                                 .def    w           = r16
                                 .def    w1          = r17
                                 .def    ledstate    = r18
                                 .def    sysstate    = r19
                                 .def    pos         = r20
                                 .def    timeidx     = r21
                                 .def    oldbtn      = r22
                                 .def    newbtn      = r23
                                 
                                 ;********************** segmento de Datos SRAM ********************************
                                 .dseg
000100                           cnt_100ms:  .byte 1
000101                           cnt_hb:     .byte 2
000103                           cnt_seq:    .byte 2
000105                           cnt_sw3:    .byte 2
000107                           cnt_pulse:  .byte 2
000109                           ctr_val:    .byte 1
00010a                           ctr_pulse:  .byte 1
                                 
                                 ; Buffer protocolo 8 bytes ASCII
00010b                           rx_buf:     .byte 8     ; S CMD P1 P2 P3 CHK_H CHK_L W
000113                           rx_idx:     .byte 1     ; índice del próximo byte (0-7)
000114                           rx_ready:   .byte 1     ; 1 = trama completa lista para procesar
                                 
                                 ;************************ segmento de Codigo **********************************
                                 .cseg
                                 .org    0x00
000000 940c 00f3                     jmp     start
                                 
                                 .org    0x1A                     ; TIMER1_COMPA vector
00001a 940c 0064                     jmp     isr_timer1
                                 
                                 .org    0x24                     ; USART_RX vector
000024 940c 0034                     jmp     isr_uart_rx
                                 
                                 .org    0x34
                                 
                                 ;-------------------------------------------------------------------
                                 ; ISR USART_RX — Ejecuta automáticamente al recibir un byte
                                 ;-------------------------------------------------------------------
                                 isr_uart_rx:
                                     ; 1. Guardar contexto (¡Crítico en ASM!)
000034 938f                          push    r24
000035 b78f                          in      r24, SREG
000036 938f                          push    r24
000037 939f                          push    r25
000038 93af                          push    r26
000039 93bf                          push    r27
00003a 93cf                          push    r28
                                 
                                     ; 2. Leer dato del registro físico
00003b 9180 00c6                     lds     r24, UDR0
                                 
                                     ; 3. Ignorar CR y LF
00003d 308d                          cpi     r24, 0x0D
00003e f0e9                          breq    rx_isr_exit
00003f 308a                          cpi     r24, 0x0A
000040 f0d9                          breq    rx_isr_exit
                                 
                                     ; 4. Si rx_ready=1 (hay trama sin procesar), descartamos byte para no corromper
000041 9190 0114                     lds     r25, rx_ready
000043 2399                          tst     r25
000044 f4b9                          brne    rx_isr_exit
                                 
                                     ; 5. Lógica de guardado
000045 9190 0113                     lds     r25, rx_idx
                                 
                                     ; Si es primer byte, validar que sea el Header 'S'
000047 2399                          tst     r25
000048 f411                          brne    rx_isr_store
000049 3583                          cpi     r24, PROTO_HEADER
00004a f489                          brne    rx_isr_exit         ; No es 'S' -> se descarta
                                 
                                 rx_isr_store:
                                     ; Guardar byte en rx_buf[rx_idx]
00004b e0ab                          ldi     r26, low(rx_buf)
00004c e0b1                          ldi     r27, high(rx_buf)
00004d 0fa9                          add     r26, r25
00004e 27cc                          clr     r28
00004f 1fbc                          adc     r27, r28
000050 938c                          st      X, r24
                                 
                                     ; rx_idx++
000051 9593                          inc     r25
000052 9390 0113                     sts     rx_idx, r25
                                 
                                     ; Verificar si completamos la trama
000054 3098                          cpi     r25, PROTO_LEN
000055 f030                          brlo    rx_isr_exit
                                 
                                     ; Trama lista -> setear bandera y reiniciar índice
000056 e091                          ldi     r25, 1
000057 9390 0114                     sts     rx_ready, r25
000059 2799                          clr     r25
00005a 9390 0113                     sts     rx_idx, r25
                                 
                                 rx_isr_exit:
                                     ; 6. Restaurar contexto
00005c 91cf                          pop     r28
00005d 91bf                          pop     r27
00005e 91af                          pop     r26
00005f 919f                          pop     r25
000060 918f                          pop     r24
000061 bf8f                          out     SREG, r24
000062 918f                          pop     r24
000063 9518                          reti
                                 
                                 ;-------------------------------------------------------------------
                                 ; ISR Timer1 — ejecuta cada 1ms
                                 ;-------------------------------------------------------------------
                                 isr_timer1:
000064 93cf                          push    r28
000065 b7cf                          in      r28, SREG
000066 93cf                          push    r28
                                 
000067 9af0                          sbi     GPIOR0, BIT_1MS
                                 
000068 91c0 0100                     lds     r28, cnt_100ms
00006a 95ca                          dec     r28
00006b 93c0 0100                     sts     cnt_100ms, r28
00006d f421                          brne    isr_exit_t1
                                 
00006e e6c4                          ldi     r28, 100
00006f 93c0 0100                     sts     cnt_100ms, r28
000071 9af1                          sbi     GPIOR0, BIT_100MS
                                 
                                 isr_exit_t1:
000072 91cf                          pop     r28
000073 bfcf                          out     SREG, r28
000074 91cf                          pop     r28
000075 9518                          reti
                                 
                                 ;-------------------------------------------------------------------
                                 ; ini_ports
                                 ;-------------------------------------------------------------------
                                 ini_ports:
000076 e20f                          ldi     w, (1<<LEDBUILTIN)|(1<<LED1)|(1<<LED2)|(1<<LED3)|(1<<LED4)
000077 b904                          out     DDRB, w
000078 e000                          ldi     w, 0
000079 b905                          out     PORTB, w
00007a e000                          ldi     w, 0
00007b b90a                          out     DDRD, w
00007c e30c                          ldi     w, (1<<SW1)|(1<<SW2)|(1<<SW3)|(1<<SW4)
00007d b90b                          out     PORTD, w
00007e 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; ini_timer1
                                 ;-------------------------------------------------------------------
                                 ini_timer1:
00007f 2700                          clr     w
000080 9300 0081                     sts     TCCR1B, w
000082 2700                          clr     w
000083 9300 0080                     sts     TCCR1A, w
000085 e000                          ldi     w, high(OCR1A_VAL)
000086 9300 0089                     sts     OCR1AH, w
000088 ef09                          ldi     w, low(OCR1A_VAL)
000089 9300 0088                     sts     OCR1AL, w
00008b 2700                          clr     w
00008c 9300 0085                     sts     TCNT1H, w
00008e 9300 0084                     sts     TCNT1L, w
000090 e002                          ldi     w, (1<<OCIE1A)
000091 9300 006f                     sts     TIMSK1, w
000093 e00b                          ldi     w, (1<<WGM12)|(1<<CS11)|(1<<CS10)
000094 9300 0081                     sts     TCCR1B, w
000096 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; ini_USART0 — Habilitando RXCIE0 para Interrupciones
                                 ;-------------------------------------------------------------------
                                 ini_USART0:
000097 e100                          ldi     w, UBRR_VAL
000098 9300 00c4                     sts     UBRR0L, w
00009a 2700                          clr     w
00009b 9300 00c5                     sts     UBRR0H, w
00009d e002                          ldi     w, (1<<U2X0)
00009e 9300 00c0                     sts     UCSR0A, w
0000a0 e006                          ldi     w, 0x06
0000a1 9300 00c2                     sts     UCSR0C, w
                                     ; ACA ACTIVAMOS LA INTERRUPCION DE RECEPCION (RXCIE0)
0000a3 e908                          ldi     w, (1<<RXEN0)|(1<<TXEN0)|(1<<RXCIE0)
0000a4 9300 00c1                     sts     UCSR0B, w
0000a6 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; update_leds
                                 ;-------------------------------------------------------------------
                                 update_leds:
0000a7 2f02                          mov     w, ledstate
0000a8 7200                          andi    w, (1<<LEDBUILTIN)
                                 
0000a9 3030                          cpi     sysstate, STATE_IDLE
0000aa f0b1                          breq    ul_mask_00
0000ab 3033                          cpi     sysstate, STATE_COUNTER
0000ac f0a1                          breq    ul_mask_00
0000ad 3031                          cpi     sysstate, STATE_UP
0000ae f049                          breq    ul_up
                                 
                                     ; STATE_DOWN
0000af 3040                          cpi     pos, 0
0000b0 f081                          breq    ul_mask_00
0000b1 3041                          cpi     pos, 1
0000b2 f091                          breq    ul_mask_08
0000b3 3042                          cpi     pos, 2
0000b4 f091                          breq    ul_mask_04
0000b5 3043                          cpi     pos, 3
0000b6 f091                          breq    ul_mask_02
0000b7 c00b                          rjmp    ul_mask_01
                                 
                                 ul_up:
0000b8 3040                          cpi     pos, 0
0000b9 f039                          breq    ul_mask_00
0000ba 3041                          cpi     pos, 1
0000bb f039                          breq    ul_mask_01
0000bc 3042                          cpi     pos, 2
0000bd f059                          breq    ul_mask_02
0000be 3043                          cpi     pos, 3
0000bf f039                          breq    ul_mask_04
0000c0 c004                          rjmp    ul_mask_08
                                 
0000c1 e010                      ul_mask_00: ldi w1, 0x00
0000c2 c008                          rjmp    ul_apply
0000c3 e011                      ul_mask_01: ldi w1, 0x01
0000c4 c006                          rjmp    ul_apply
0000c5 e018                      ul_mask_08: ldi w1, 0x08
0000c6 c004                          rjmp    ul_apply
0000c7 e014                      ul_mask_04: ldi w1, 0x04
0000c8 c002                          rjmp    ul_apply
0000c9 e012                      ul_mask_02: ldi w1, 0x02
0000ca c000                          rjmp    ul_apply
                                 
                                 ul_apply:
0000cb 2b01                          or      w, w1
0000cc 2f20                          mov     ledstate, w
0000cd b925                          out     PORTB, ledstate
0000ce 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; get_delay
                                 ;-------------------------------------------------------------------
                                 get_delay:
0000cf 3050                          cpi     timeidx, 0
0000d0 f039                          breq    gd_250
0000d1 3051                          cpi     timeidx, 1
0000d2 f041                          breq    gd_500
0000d3 3052                          cpi     timeidx, 2
0000d4 f049                          breq    gd_1000
0000d5 ed80                          ldi     r24, low(2000)
0000d6 e097                          ldi     r25, high(2000)
0000d7 9508                          ret
                                 gd_250:
0000d8 ef8a                          ldi     r24, low(250)
0000d9 e090                          ldi     r25, high(250)
0000da 9508                          ret
                                 gd_500:
0000db ef84                          ldi     r24, low(500)
0000dc e091                          ldi     r25, high(500)
0000dd 9508                          ret
                                 gd_1000:
0000de ee88                          ldi     r24, low(1000)
0000df e093                          ldi     r25, high(1000)
0000e0 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; enter_counter
                                 ;-------------------------------------------------------------------
                                 enter_counter:
0000e1 e033                          ldi     sysstate, STATE_COUNTER
0000e2 2700                          clr     w
0000e3 9300 0109                     sts     ctr_val,    w
0000e5 9300 010a                     sts     ctr_pulse,  w
0000e7 9300 0107                     sts     cnt_pulse,  w
0000e9 9300 0108                     sts     cnt_pulse+1,w
0000eb 940e 00a7                     call    update_leds
0000ed 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; exit_counter
                                 ;-------------------------------------------------------------------
                                 exit_counter:
0000ee e030                          ldi     sysstate, STATE_IDLE
0000ef 2744                          clr     pos
0000f0 940e 00a7                     call    update_leds
0000f2 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; start
                                 ;-------------------------------------------------------------------
                                 start:
0000f3 94f8                          cli
0000f4 ef0f                          ldi     w, low(RAMEND)
0000f5 bf0d                          out     SPL, w
0000f6 e008                          ldi     w, high(RAMEND)
0000f7 bf0e                          out     SPH, w
                                 
0000f8 940e 0076                     call    ini_ports
                                 
0000fa ba1e                          out     GPIOR0, r1
                                 
0000fb e604                          ldi     w, 100
0000fc 9300 0100                     sts     cnt_100ms, w
0000fe 2700                          clr     w
0000ff 9300 0101                     sts     cnt_hb,     w
000101 9300 0102                     sts     cnt_hb+1,   w
000103 9300 0103                     sts     cnt_seq,    w
000105 9300 0104                     sts     cnt_seq+1,  w
000107 9300 0105                     sts     cnt_sw3,    w
000109 9300 0106                     sts     cnt_sw3+1,  w
00010b 9300 0107                     sts     cnt_pulse,  w
00010d 9300 0108                     sts     cnt_pulse+1,w
00010f 9300 0109                     sts     ctr_val,    w
000111 9300 010a                     sts     ctr_pulse,  w
000113 9300 0113                     sts     rx_idx,     w
000115 9300 0114                     sts     rx_ready,   w
                                 
000117 2722                          clr     ledstate
000118 e030                          ldi     sysstate, STATE_IDLE
000119 2744                          clr     pos
00011a e051                          ldi     timeidx, 1
                                 
00011b b169                          in      oldbtn, PIND
00011c 736c                          andi    oldbtn, (1<<SW1)|(1<<SW2)|(1<<SW3)|(1<<SW4)
                                 
00011d 940e 007f                     call    ini_timer1
00011f 940e 0097                     call    ini_USART0
000121 9478                          sei
                                 
                                 ;-------------------------------------------------------------------
                                 ; LOOP PRINCIPAL
                                 ;-------------------------------------------------------------------
                                 loop:
                                     ;--- [1] Esperar flag_1ms ----------------------------------------
000122 9bf0                          sbis    GPIOR0, BIT_1MS
000123 cffe                          rjmp    loop
000124 98f0                          cbi     GPIOR0, BIT_1MS
                                 
                                     ;--- [2] Leer botones y detectar flancos -------------------------
000125 b179                          in      newbtn, PIND
000126 737c                          andi    newbtn, (1<<SW1)|(1<<SW2)|(1<<SW3)|(1<<SW4)
                                 
000127 2f07                          mov     w, newbtn
000128 9500                          com     w
000129 2306                          and     w, oldbtn
                                 
00012a 2f16                          mov     w1, oldbtn
00012b 9510                          com     w1
00012c 2317                          and     w1, newbtn
                                 
                                     ;--- [3] SW3: corto vs largo -------------------------------------
00012d 2f87                          mov     r24, newbtn
00012e 9580                          com     r24
00012f 7180                          andi    r24, (1<<SW3)
000130 f089                          breq    sw3_not_held
                                 
000131 91a0 0105                     lds     r26, cnt_sw3
000133 91b0 0106                     lds     r27, cnt_sw3+1
000135 ed80                          ldi     r24, low(SW3_LIMIT)
000136 e097                          ldi     r25, high(SW3_LIMIT)
000137 17a8                          cp      r26, r24
000138 07b9                          cpc     r27, r25
000139 f041                          breq    sw3_not_held
00013a e081                          ldi     r24, 1
00013b 0fa8                          add     r26, r24
00013c 2788                          clr     r24
00013d 1fb8                          adc     r27, r24
00013e 93a0 0105                     sts     cnt_sw3,   r26
000140 93b0 0106                     sts     cnt_sw3+1, r27
                                 
                                 sw3_not_held:
000142 ff14                          sbrs    w1, SW3
000143 c021                          rjmp    skip_sw3
                                 
000144 91a0 0105                     lds     r26, cnt_sw3
000146 91b0 0106                     lds     r27, cnt_sw3+1
000148 2788                          clr     r24
000149 9380 0105                     sts     cnt_sw3,   r24
00014b 9380 0106                     sts     cnt_sw3+1, r24
                                 
00014d ed80                          ldi     r24, low(SW3_LIMIT)
00014e e097                          ldi     r25, high(SW3_LIMIT)
00014f 17a8                          cp      r26, r24
000150 07b9                          cpc     r27, r25
000151 f040                          brlo    sw3_short
                                 
                                 sw3_long:
000152 3033                          cpi     sysstate, STATE_COUNTER
000153 f019                          breq    sw3_do_exit
000154 940e 00e1                     call    enter_counter
000156 c00e                          rjmp    skip_sw3
                                 sw3_do_exit:
000157 940e 00ee                     call    exit_counter
000159 c00b                          rjmp    skip_sw3
                                 
                                 sw3_short:
00015a 3033                          cpi     sysstate, STATE_COUNTER
00015b f049                          breq    skip_sw3
00015c e030                          ldi     sysstate, STATE_IDLE
00015d 2744                          clr     pos
00015e 2700                          clr     w
00015f 9300 0103                     sts     cnt_seq,   w
000161 9300 0104                     sts     cnt_seq+1, w
000163 940e 00a7                     call    update_leds
                                 
                                 skip_sw3:
                                 
                                     ;--- [4] SW1 -----------------------------------------------------
000165 ff02                          sbrs    w, SW1
000166 c019                          rjmp    skip_sw1
                                 
000167 3033                          cpi     sysstate, STATE_COUNTER
000168 f041                          breq    sw1_counter
                                 
000169 e031                          ldi     sysstate, STATE_UP
00016a 2744                          clr     pos
00016b 2700                          clr     w
00016c 9300 0103                     sts     cnt_seq,   w
00016e 9300 0104                     sts     cnt_seq+1, w
000170 c00f                          rjmp    skip_sw1
                                 
                                 sw1_counter:
000171 9100 0109                     lds     w, ctr_val
000173 9503                          inc     w
000174 3006                          cpi     w, 6
000175 f008                          brlo    sw1_ctr_store
000176 2700                          clr     w
                                 sw1_ctr_store:
000177 9300 0109                     sts     ctr_val, w
000179 2700                          clr     w
00017a 9300 010a                     sts     ctr_pulse,  w
00017c 9300 0107                     sts     cnt_pulse,  w
00017e 9300 0108                     sts     cnt_pulse+1,w
                                 
                                 skip_sw1:
                                 
