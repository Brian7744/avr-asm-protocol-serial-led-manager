                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Aplicacion2.asm
                                 ;
                                 ; Created: 17/3/2026 11:30:35
                                 ; Author : brian
                                 ;
                                 #include <m328pdef.inc>
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;**************************** Igualdades **************************************
                                 
                                 
                                 
                                 ; Etiquetas para los pines
                                 .equ    LEDBUILTIN  = PB5
                                 .equ    LED1        = PB0
                                 .equ    LED2        = PB1
                                 .equ    LED3        = PB2
                                 .equ    LED4        = PB3
                                 .equ    SW1         = PD2
                                 .equ    SW2         = PD3
                                 .equ    SW3         = PD4
                                 .equ    SW4         = PD5
                                 
                                 .equ    STATE_IDLE  = 0
                                 .equ    STATE_UP    = 1
                                 .equ    STATE_DOWN  = 2
                                 .equ    STATE_COUNTER   = 3
                                 
                                 ; Bits en GPIOR0
                                 .equ    BIT_1MS         = 0     ; bit0 = flag 1ms
                                 .equ    BIT_100MS       = 1     ; bit1 = flag 100ms 
                                 
                                 ; Etiqueta para la configuracion del timer1 
                                 .equ    OCR1A_VAL   = 249       ; 16MHz / 64 / 1000 - 1 = 249 ? ISR cada 1ms
                                 
                                 
                                 ; Tiempos heartbeat (en unidades de 100ms)
                                 .equ    HB_PERIOD       = 30    ; 30 x 100ms = 3s período completo
                                 .equ    HB_PULSE        = 1     ; 1 x 100ms = 100ms duración del flash
                                 .equ    SW3_LIMIT        = 2000  ; 2000ms para considerar pulsación larga
                                 
                                 
                                 ; UART — 115200 baud @ 16MHz con U2X0=1
                                 ; UBRR = (16.000.000 / 8 / 115200) - 1 = 16
                                 .equ    UBRR_VAL        = 16
                                 
                                 ; Comandos simples UART (provisorios, antes del protocolo)
                                 .equ    CMD_START_COUNTER = 'y'
                                 .equ    CMD_STOP_COUNTER  = 'n'
                                 
                                 ;****************** definiciones - nombres simbolicos *************************
                                 .def	w			= r16
                                 .def	w1			= r17
                                 .def	ledstate	= r18
                                 .def	sysstate	= r19
                                 .def    pos         = r20
                                 .def	timeidx		= r21
                                 .def    oldbtn      = r22
                                 .def    newbtn      = r23
                                 
                                 
                                 
                                 ;********************** segmento de Datos SRAM ********************************
                                 .dseg
                                 ;statboot:	.BYTE	1
                                 ;addrrx:		.BYTE	2
                                 ;RXBUFTX:	.BYTE	BUFSIZETX
                                 
000100                           cnt_100ms:  .byte 1     ; cuenta regresiva 100?0 en ISR
000101                           cnt_hb:     .byte 2     ; contador heartbeat en x100ms (0?29 = 3s)
000103                           cnt_seq:    .byte 2     ; contador secuencia en ms
000105                           cnt_sw3:    .byte 2     ; contador de tiempo pulsado SW3 (ms)
000107                           cnt_pulse:  .byte 2     ; contador para pulsos del modo contador (ms)
000109                           ctr_val:    .byte 1     ; valor del contador (0-5) en modo COUNTER
00010a                           ctr_pulse:  .byte 1     ; pulso actual mostrando en modo COUNTER
                                 
                                 ;************************ segmento de Codigo **********************************
                                 .cseg
                                 .org	0x00
000000 940c 00c3                 	jmp	start
                                 ;interrupciones	
                                 .org    0x1A                    ; TIMER1_COMPA vector
00001a 940c 0034                     jmp     isr_timer1
                                 ;.org	0x24
                                 ;	jmp	USART_RXC
                                 .org    0x34                    ; fin de tabla de vectores. Pregunta: Es necesario
                                 
                                 ;Servicio de interrupciones
                                 
                                 ;-------------------------------------------------------------------
                                 ; ISR Timer1 — ejecuta cada 1ms
                                 ;-------------------------------------------------------------------
                                 isr_timer1:
000034 93cf                          push    r28
000035 b7cf                          in      r28, SREG
000036 93cf                          push    r28
                                 
                                     ; --- setear flag_1ms ---
000037 9af0                          sbi     GPIOR0, BIT_1MS
                                 
                                     ; --- decrementar cnt_100ms ---
000038 91c0 0100                     lds     r28, cnt_100ms
00003a 95ca                          dec     r28
00003b 93c0 0100                     sts     cnt_100ms, r28
00003d f421                          brne    isr_exit            ; si no llegó a 0, salir
                                 
                                     ; --- llegó a 0: recargar y setear flag_100ms ---
00003e e6c4                          ldi     r28, 100
00003f 93c0 0100                     sts     cnt_100ms, r28
000041 9af1                          sbi     GPIOR0, BIT_100MS
                                 
                                 isr_exit:
000042 91cf                          pop     r28
000043 bfcf                          out     SREG, r28
000044 91cf                          pop     r28
000045 9518                          reti
                                 
                                 
                                 
                                 ;**** Funciones ****
                                 ;-------------------------------------------------------------------
                                 ; ini_ports
                                 ;-------------------------------------------------------------------
                                 ini_ports:
                                     ; cpnfiguracion de las salidas
000046 e20f                      	ldi     w, (1<<LEDBUILTIN)|(1<<LED1)|(1<<LED2)|(1<<LED3)|(1<<LED4)
000047 b904                          out     DDRB, w	; el bit que tenga 1 indica que es una salida
000048 e000                          ldi     w, 0
000049 b905                          out     PORTB, w ; apaga todos los led asociados al puerto
                                     ; configuracion de las entradas
00004a e000                      	ldi     w, 0
00004b b90a                          out     DDRD, w
00004c e30c                          ldi     w, (1<<SW1)|(1<<SW2)|(1<<SW3)|(1<<SW4)
00004d b90b                          out     PORTD, w
00004e 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; ini_timer1 — CTC, prescaler 64, OCR1A = 249 ? ISR cada 1ms
                                 ;-------------------------------------------------------------------
                                 ini_timer1:
                                     ; Asegurarse que Timer1 está detenido antes de configurar
00004f 2700                          clr     w
000050 9300 0081                     sts     TCCR1B, w
                                 
                                     ; TCCR1A = 0 (modo CTC no usa OC1A/OC1B)
000052 2700                          clr     w
000053 9300 0080                     sts     TCCR1A, w
                                 
                                     ; OCR1A = 249
000055 e000                          ldi     w, high(OCR1A_VAL)
000056 9300 0089                     sts     OCR1AH, w
000058 ef09                          ldi     w, low(OCR1A_VAL)
000059 9300 0088                     sts     OCR1AL, w
                                 
                                     ; Limpiar contador Timer1
00005b 2700                          clr     w
00005c 9300 0085                     sts     TCNT1H, w
00005e 9300 0084                     sts     TCNT1L, w
                                 
                                     ; Habilitar interrupción por comparación A (OCIE1A)
000060 e002                          ldi     w, (1<<OCIE1A)
000061 9300 006f                     sts     TIMSK1, w
                                 
                                     ; TCCR1B: modo CTC (WGM12=1) + prescaler 64 (CS11=1, CS10=1)
000063 e00b                          ldi     w, (1<<WGM12)|(1<<CS11)|(1<<CS10)
000064 9300 0081                     sts     TCCR1B, w
000066 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; ini_USART0 — 115200 baud, 8N1, polling
                                 ; Orden de configuración: UBRR0L ? UBRR0H ? UCSR0A ? UCSR0C ? UCSR0B
                                 ; U2X0=1 (doble velocidad): UBRR = 16MHz / 8 / 115200 - 1 = 16
                                 ;-------------------------------------------------------------------
                                 ini_USART0:
000067 e100                          ldi     w, UBRR_VAL
000068 9300 00c4                     sts     UBRR0L, w           ; baud rate low
00006a 2700                          clr     w
00006b 9300 00c5                     sts     UBRR0H, w           ; baud rate high = 0
00006d e002                          ldi     w, (1<<U2X0)        ; doble velocidad
00006e 9300 00c0                     sts     UCSR0A, w
000070 e006                          ldi     w, 0x06             ; 8N1: UCSZ01=1, UCSZ00=1
000071 9300 00c2                     sts     UCSR0C, w
000073 e108                          ldi     w, (1<<RXEN0)|(1<<TXEN0)  ; habilitar RX y TX, sin ISR
000074 9300 00c1                     sts     UCSR0B, w
000076 9508                          ret
                                 ;-------------------------------------------------------------------
                                 ; update_leds 
                                 ; Preserva LEDBUILTIN. Interpreta sysstate y pos.
                                 ; En STATE_COUNTER apaga los LEDs de secuencia (los pulsos
                                 ; los maneja el loop principal directamente).
                                 ;-------------------------------------------------------------------
                                 update_leds:
000077 2f02                          mov     w, ledstate
000078 7200                          andi    w, (1<<LEDBUILTIN)
                                  
000079 3030                          cpi     sysstate, STATE_IDLE
00007a f0b1                          breq    ul_mask_00
00007b 3033                          cpi     sysstate, STATE_COUNTER
00007c f0a1                          breq    ul_mask_00          ; en modo contador los LEDs los maneja el loop
00007d 3031                          cpi     sysstate, STATE_UP
00007e f049                          breq    ul_up
                                  
                                     ; STATE_DOWN
00007f 3040                          cpi     pos, 0
000080 f081                          breq    ul_mask_00		;				= 0000
000081 3041                          cpi     pos, 1
000082 f091                          breq    ul_mask_08		;               = 1000
000083 3042                          cpi     pos, 2
000084 f091                          breq    ul_mask_04		; 0x0C -> 0x04	= 0100
000085 3043                          cpi     pos, 3
000086 f091                          breq    ul_mask_02		; 0x0E -> 0x02  = 0010
000087 c00b                          rjmp    ul_mask_01		; 0x0F -> 0x01	= 0001
                                  
                                 ul_up:
000088 3040                          cpi     pos, 0
000089 f039                          breq    ul_mask_00		;				= 0000
00008a 3041                          cpi     pos, 1
00008b f039                          breq    ul_mask_01		;				= 0001
00008c 3042                          cpi     pos, 2
00008d f059                          breq    ul_mask_02		; 0x03 -> 0x02  = 0010
00008e 3043                          cpi     pos, 3
00008f f039                          breq    ul_mask_04		; 0x07 -> 0x04	= 0100
000090 c004                          rjmp    ul_mask_08		; 0x0F -> 0x08  = 1000
                                  
000091 e010                      ul_mask_00: ldi w1, 0x00
000092 c008                          rjmp    ul_apply
000093 e011                      ul_mask_01: ldi w1, 0x01
000094 c006                          rjmp    ul_apply
000095 e018                      ul_mask_08: ldi w1, 0x08
000096 c004                          rjmp    ul_apply
000097 e014                      ul_mask_04: ldi w1, 0x04
000098 c002                          rjmp    ul_apply
000099 e012                      ul_mask_02: ldi w1, 0x02
00009a c000                          rjmp    ul_apply
                                 
                                 ul_apply:
00009b 2b01                          or      w, w1
00009c 2f20                          mov     ledstate, w
00009d b925                          out     PORTB, ledstate
00009e 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; get_delay — devuelve límite en r24:r25 según timeidx
                                 ;   0 ? 250ms  1 ? 500ms  2 ? 1000ms  3 ? 2000ms
                                 ;-------------------------------------------------------------------
                                 get_delay:
00009f 3050                          cpi     timeidx, 0
0000a0 f039                          breq    gd_250
0000a1 3051                          cpi     timeidx, 1
0000a2 f041                          breq    gd_500
0000a3 3052                          cpi     timeidx, 2
0000a4 f049                          breq    gd_1000
0000a5 ed80                          ldi     r24, low(2000)
0000a6 e097                          ldi     r25, high(2000)
0000a7 9508                          ret
                                 gd_250:
0000a8 ef8a                          ldi     r24, low(250)
0000a9 e090                          ldi     r25, high(250)
0000aa 9508                          ret
                                 gd_500:
0000ab ef84                          ldi     r24, low(500)
0000ac e091                          ldi     r25, high(500)
0000ad 9508                          ret
                                 gd_1000:
0000ae ee88                          ldi     r24, low(1000)
0000af e093                          ldi     r25, high(1000)
0000b0 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; enter_counter — lógica de entrada a modo COUNTER
                                 ; (usada tanto desde SW3 largo como desde UART)
                                 ;-------------------------------------------------------------------
                                 enter_counter:
0000b1 e033                          ldi     sysstate, STATE_COUNTER
0000b2 2700                          clr     w
0000b3 9300 0109                     sts     ctr_val,    w
0000b5 9300 010a                     sts     ctr_pulse,  w
0000b7 9300 0107                     sts     cnt_pulse,  w
0000b9 9300 0108                     sts     cnt_pulse+1,w
0000bb 940e 0077                     call    update_leds
0000bd 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; exit_counter — lógica de salida de modo COUNTER ? IDLE
                                 ;-------------------------------------------------------------------
                                 exit_counter:
0000be e030                          ldi     sysstate, STATE_IDLE
0000bf 2744                          clr     pos
0000c0 940e 0077                     call    update_leds
0000c2 9508                          ret
                                 
                                 ;Like a main in C
                                 start:
0000c3 94f8                          cli
0000c4 ef0f                          ldi     w, low(RAMEND)
0000c5 bf0d                          out     SPL, w
0000c6 e008                          ldi     w, high(RAMEND)
0000c7 bf0e                          out     SPH, w
                                 
0000c8 940e 0046                     call    ini_ports
                                 
                                 	; Limpiar GPIOR0 (flags)
0000ca ba1e                          out     GPIOR0, r1          ; r1 = 0 siempre en AVR por convenio
                                     
                                 	; Inicializar variables en SRAM
                                     
0000cb e604                      	ldi     w, 100
0000cc 9300 0100                     sts     cnt_100ms, w       ; cnt_100ms arranca en 100
0000ce 2700                          clr     w
0000cf 9300 0101                     sts     cnt_hb,     w
0000d1 9300 0102                     sts     cnt_hb+1,   w
0000d3 9300 0103                     sts     cnt_seq,    w
0000d5 9300 0104                     sts     cnt_seq+1,  w
0000d7 9300 0105                     sts     cnt_sw3,    w
0000d9 9300 0106                     sts     cnt_sw3+1,  w
0000db 9300 0107                     sts     cnt_pulse,  w
0000dd 9300 0108                     sts     cnt_pulse+1,w
0000df 9300 0109                     sts     ctr_val,    w
0000e1 9300 010a                     sts     ctr_pulse,  w
                                 
                                     ; Inicializar registros
0000e3 2722                          clr     ledstate
0000e4 e030                          ldi     sysstate, STATE_IDLE
0000e5 2744                          clr     pos
0000e6 e051                          ldi     timeidx, 1          ; tiempo inicial = 500ms
                                 
                                     ; Leer estado inicial de botones
0000e7 b169                          in      oldbtn, PIND
0000e8 736c                          andi    oldbtn, (1<<SW1)|(1<<SW2)|(1<<SW3)|(1<<SW4)
                                 
0000e9 940e 004f                     call    ini_timer1
0000eb 940e 0067                     call    ini_USART0
0000ed 9478                          sei                         ; habilitar interrupciones globales
                                 
                                 ;-------------------------------------------------------------------
                                 ; LOOP PRINCIPAL
                                 ;-------------------------------------------------------------------
                                 loop:
                                     ;--- [1] Esperar flag_1ms ----------------------------------------
0000ee 9bf0                          sbis    GPIOR0, BIT_1MS
0000ef cffe                          rjmp    loop
0000f0 98f0                          cbi     GPIOR0, BIT_1MS
                                 
                                     ;--- [2] Leer botones y detectar flancos -------------------------
0000f1 b179                          in      newbtn, PIND
0000f2 737c                          andi    newbtn, (1<<SW1)|(1<<SW2)|(1<<SW3)|(1<<SW4)
                                 
0000f3 2f07                          mov     w, newbtn
0000f4 9500                          com     w
0000f5 2306                          and     w, oldbtn           ; w  = flancos descendentes
                                 
0000f6 2f16                          mov     w1, oldbtn
0000f7 9510                          com     w1
0000f8 2317                          and     w1, newbtn          ; w1 = flancos ascendentes
                                 
                                     ;--- [3] SW3: corto vs largo -------------------------------------
0000f9 2f87                          mov     r24, newbtn
0000fa 9580                          com     r24
0000fb 7180                          andi    r24, (1<<SW3)
0000fc f089                          breq    sw3_not_held
                                 
0000fd 91a0 0105                     lds     r26, cnt_sw3
0000ff 91b0 0106                     lds     r27, cnt_sw3+1
000101 ed80                          ldi     r24, low(SW3_LIMIT)
000102 e097                          ldi     r25, high(SW3_LIMIT)
000103 17a8                          cp      r26, r24
000104 07b9                          cpc     r27, r25
000105 f041                          breq    sw3_not_held
000106 e081                          ldi     r24, 1
000107 0fa8                          add     r26, r24
000108 2788                          clr     r24
000109 1fb8                          adc     r27, r24
00010a 93a0 0105                     sts     cnt_sw3,   r26
00010c 93b0 0106                     sts     cnt_sw3+1, r27
                                 
                                 sw3_not_held:
00010e ff14                          sbrs    w1, SW3
00010f c021                          rjmp    skip_sw3
                                 
000110 91a0 0105                     lds     r26, cnt_sw3
000112 91b0 0106                     lds     r27, cnt_sw3+1
000114 2788                          clr     r24
000115 9380 0105                     sts     cnt_sw3,   r24
000117 9380 0106                     sts     cnt_sw3+1, r24
                                 
000119 ed80                          ldi     r24, low(SW3_LIMIT)
00011a e097                          ldi     r25, high(SW3_LIMIT)
00011b 17a8                          cp      r26, r24
00011c 07b9                          cpc     r27, r25
00011d f040                          brlo    sw3_short
                                 
                                 sw3_long:
00011e 3033                          cpi     sysstate, STATE_COUNTER
00011f f019                          breq    sw3_do_exit
000120 940e 00b1                     call    enter_counter
000122 c00e                          rjmp    skip_sw3
                                 sw3_do_exit:
000123 940e 00be                     call    exit_counter
000125 c00b                          rjmp    skip_sw3
                                 
                                 sw3_short:
000126 3033                          cpi     sysstate, STATE_COUNTER
000127 f049                          breq    skip_sw3
000128 e030                          ldi     sysstate, STATE_IDLE
000129 2744                          clr     pos
00012a 2700                          clr     w
00012b 9300 0103                     sts     cnt_seq,   w
00012d 9300 0104                     sts     cnt_seq+1, w
00012f 940e 0077                     call    update_leds
                                 
                                 skip_sw3:
                                 
                                     ;--- [4] SW1 -----------------------------------------------------
000131 ff02                          sbrs    w, SW1
000132 c019                          rjmp    skip_sw1
                                 
000133 3033                          cpi     sysstate, STATE_COUNTER
000134 f041                          breq    sw1_counter
                                 
000135 e031                          ldi     sysstate, STATE_UP
000136 2744                          clr     pos
000137 2700                          clr     w
000138 9300 0103                     sts     cnt_seq,   w
00013a 9300 0104                     sts     cnt_seq+1, w
00013c c00f                          rjmp    skip_sw1
                                 
                                 sw1_counter:
00013d 9100 0109                     lds     w, ctr_val
00013f 9503                          inc     w
000140 3006                          cpi     w, 6
000141 f008                          brlo    sw1_ctr_store
000142 2700                          clr     w
                                 sw1_ctr_store:
000143 9300 0109                     sts     ctr_val, w
000145 2700                          clr     w
000146 9300 010a                     sts     ctr_pulse,  w
000148 9300 0107                     sts     cnt_pulse,  w
00014a 9300 0108                     sts     cnt_pulse+1,w
                                 
                                 skip_sw1:
                                 
                                     ;--- [5] SW2 -----------------------------------------------------
00014c ff03                          sbrs    w, SW2
00014d c009                          rjmp    skip_sw2
00014e 3033                          cpi     sysstate, STATE_COUNTER
00014f f039                          breq    skip_sw2
000150 e032                          ldi     sysstate, STATE_DOWN
000151 2744                          clr     pos
000152 2700                          clr     w
000153 9300 0103                     sts     cnt_seq,   w
000155 9300 0104                     sts     cnt_seq+1, w
                                 skip_sw2:
                                 
                                     ;--- [6] SW4 -----------------------------------------------------
000157 ff05                          sbrs    w, SW4
