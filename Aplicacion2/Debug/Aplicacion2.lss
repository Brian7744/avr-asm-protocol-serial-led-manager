                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ; Aplicacion2.asm
                                 ;
                                 ; Created: 17/3/2026 11:30:35
                                 ; Author : brian
                                 ;
                                 #include <m328pdef.inc>
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 ;**************************** Igualdades **************************************
                                 ;.equ	BUFSIZETX = 32
                                 
                                 
                                 ; Etiquetas para los pines
                                 .equ    LEDBUILTIN  = PB5
                                 .equ    LED1        = PB0
                                 .equ    LED2        = PB1
                                 .equ    LED3        = PB2
                                 .equ    LED4        = PB3
                                 .equ    SW1         = PD2
                                 .equ    SW2         = PD3
                                 .equ    SW3         = PD4
                                 .equ    SW4         = PD5
                                 
                                 .equ    STATE_IDLE  = 0
                                 .equ    STATE_UP    = 1
                                 .equ    STATE_DOWN  = 2
                                 .equ    STATE_COUNTER   = 3
                                 
                                 ; Bits en GPIOR0
                                 .equ    BIT_1MS         = 0     ; bit0 = flag 1ms
                                 .equ    BIT_100MS       = 1     ; bit1 = flag 100ms 
                                 
                                 ; Etiqueta para la configuracion del timer1 
                                 .equ    OCR1A_VAL   = 249       ; 16MHz / 64 / 1000 - 1 = 249 ? ISR cada 1ms
                                 
                                 
                                 ; Tiempos heartbeat (en unidades de 100ms)
                                 .equ    HB_PERIOD       = 30    ; 30 x 100ms = 3s período completo
                                 .equ    HB_PULSE        = 1     ; 1 x 100ms = 100ms duración del flash
                                 .equ    SW3_LIMIT        = 2000  ; 2000ms para considerar pulsación larga
                                 
                                 ;****************** definiciones - nombres simbolicos *************************
                                 .def	w			= r16
                                 .def	w1			= r17
                                 .def	ledstate	= r18
                                 .def	sysstate	= r19
                                 .def    pos         = r20
                                 .def	timeidx		= r21
                                 .def    oldbtn      = r22
                                 .def    newbtn      = r23
                                 
                                 
                                 
                                 ;********************** segmento de Datos SRAM ********************************
                                 .dseg
                                 ;statboot:	.BYTE	1
                                 ;addrrx:		.BYTE	2
                                 ;RXBUFTX:	.BYTE	BUFSIZETX
                                 
000100                           cnt_100ms:  .byte 1     ; cuenta regresiva 100?0 en ISR
000101                           cnt_hb:     .byte 2     ; contador heartbeat en x100ms (0?29 = 3s)
000103                           cnt_seq:    .byte 2     ; contador secuencia en ms
000105                           cnt_sw3:    .byte 2     ; contador de tiempo pulsado SW3 (ms)
000107                           cnt_pulse:  .byte 2     ; contador para pulsos del modo contador (ms)
000109                           ctr_val:    .byte 1     ; valor del contador (0-5) en modo COUNTER
00010a                           ctr_pulse:  .byte 1     ; pulso actual mostrando en modo COUNTER
                                 
                                 ;************************ segmento de Codigo **********************************
                                 .cseg
                                 .org	0x00
000000 940c 00a1                 	jmp	start
                                 ;interrupciones	
                                 .org    0x1A                    ; TIMER1_COMPA vector
00001a 940c 0034                     jmp     isr_timer1
                                 ;.org	0x24
                                 ;	jmp	USART_RXC
                                 .org    0x34                    ; fin de tabla de vectores. Pregunta: Es necesario
                                 
                                 
                                 
                                 ;Servicio de interrupciones
                                 isr_timer1:
000034 93cf                          push    r28
000035 b7cf                          in      r28, SREG
000036 93cf                          push    r28
                                 
                                     ; --- setear flag_1ms ---
000037 9af0                          sbi     GPIOR0, BIT_1MS
                                 
                                     ; --- decrementar cnt_100ms ---
000038 91c0 0100                     lds     r28, cnt_100ms
00003a 95ca                          dec     r28
00003b 93c0 0100                     sts     cnt_100ms, r28
00003d f421                          brne    isr_exit            ; si no llegó a 0, salir
                                 
                                     ; --- llegó a 0: recargar y setear flag_100ms ---
00003e e6c4                          ldi     r28, 100
00003f 93c0 0100                     sts     cnt_100ms, r28
000041 9af1                          sbi     GPIOR0, BIT_100MS
                                 
                                 isr_exit:
000042 91cf                          pop     r28
000043 bfcf                          out     SREG, r28
000044 91cf                          pop     r28
000045 9518                          reti
                                 
                                 
                                 
                                 ;**** Funciones ****
                                 
                                 ini_ports:
                                     ; cpnfiguracion de las salidas
000046 e20f                      	ldi     w, (1<<LEDBUILTIN)|(1<<LED1)|(1<<LED2)|(1<<LED3)|(1<<LED4)
000047 b904                          out     DDRB, w	; el bit que tenga 1 indica que es una salida
000048 e000                          ldi     w, 0
000049 b905                          out     PORTB, w ; apaga todos los led asociados al puerto
                                     ; configuracion de las entradas
00004a e000                      	ldi     w, 0
00004b b90a                          out     DDRD, w
00004c e30c                          ldi     w, (1<<SW1)|(1<<SW2)|(1<<SW3)|(1<<SW4)
00004d b90b                          out     PORTD, w
00004e 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; ini_timer1 — CTC, prescaler 64, OCR1A = 249 ? ISR cada 1ms
                                 ;-------------------------------------------------------------------
                                 ini_timer1:
                                     ; Asegurarse que Timer1 está detenido antes de configurar
00004f 2700                          clr     w
000050 9300 0081                     sts     TCCR1B, w
                                 
                                     ; TCCR1A = 0 (modo CTC no usa OC1A/OC1B)
000052 2700                          clr     w
000053 9300 0080                     sts     TCCR1A, w
                                 
                                     ; OCR1A = 249
000055 e000                          ldi     w, high(OCR1A_VAL)
000056 9300 0089                     sts     OCR1AH, w
000058 ef09                          ldi     w, low(OCR1A_VAL)
000059 9300 0088                     sts     OCR1AL, w
                                 
                                     ; Limpiar contador Timer1
00005b 2700                          clr     w
00005c 9300 0085                     sts     TCNT1H, w
00005e 9300 0084                     sts     TCNT1L, w
                                 
                                     ; Habilitar interrupción por comparación A (OCIE1A)
000060 e002                          ldi     w, (1<<OCIE1A)
000061 9300 006f                     sts     TIMSK1, w
                                 
                                     ; TCCR1B: modo CTC (WGM12=1) + prescaler 64 (CS11=1, CS10=1)
000063 e00b                          ldi     w, (1<<WGM12)|(1<<CS11)|(1<<CS10)
000064 9300 0081                     sts     TCCR1B, w
000066 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; update_leds 
                                 ; Preserva LEDBUILTIN. Interpreta sysstate y pos.
                                 ; En STATE_COUNTER apaga los LEDs de secuencia (los pulsos
                                 ; los maneja el loop principal directamente).
                                 ;-------------------------------------------------------------------
                                 update_leds:
000067 2f02                          mov     w, ledstate
000068 7200                          andi    w, (1<<LEDBUILTIN)
                                  
000069 3030                          cpi     sysstate, STATE_IDLE
00006a f0b1                          breq    ul_mask_00
00006b 3033                          cpi     sysstate, STATE_COUNTER
00006c f0a1                          breq    ul_mask_00          ; en modo contador los LEDs los maneja el loop
00006d 3031                          cpi     sysstate, STATE_UP
00006e f049                          breq    ul_up
                                  
                                     ; STATE_DOWN
00006f 3040                          cpi     pos, 0
000070 f081                          breq    ul_mask_00		;				= 0000
000071 3041                          cpi     pos, 1
000072 f091                          breq    ul_mask_08		;               = 1000
000073 3042                          cpi     pos, 2
000074 f091                          breq    ul_mask_04		; 0x0C -> 0x04	= 0100
000075 3043                          cpi     pos, 3
000076 f091                          breq    ul_mask_02		; 0x0E -> 0x02  = 0010
000077 c00b                          rjmp    ul_mask_01		; 0x0F -> 0x01	= 0001
                                  
                                 ul_up:
000078 3040                          cpi     pos, 0
000079 f039                          breq    ul_mask_00		;				= 0000
00007a 3041                          cpi     pos, 1
00007b f039                          breq    ul_mask_01		;				= 0001
00007c 3042                          cpi     pos, 2
00007d f059                          breq    ul_mask_02		; 0x03 -> 0x02  = 0010
00007e 3043                          cpi     pos, 3
00007f f039                          breq    ul_mask_04		; 0x07 -> 0x04	= 0100
000080 c004                          rjmp    ul_mask_08		; 0x0F -> 0x08  = 1000
                                  
000081 e010                      ul_mask_00: ldi w1, 0x00
000082 c008                          rjmp    ul_apply
000083 e011                      ul_mask_01: ldi w1, 0x01
000084 c006                          rjmp    ul_apply
000085 e018                      ul_mask_08: ldi w1, 0x08
000086 c004                          rjmp    ul_apply
000087 e014                      ul_mask_04: ldi w1, 0x04
000088 c002                          rjmp    ul_apply
000089 e012                      ul_mask_02: ldi w1, 0x02
00008a c000                          rjmp    ul_apply
                                 
                                 ul_apply:
00008b 2b01                          or      w, w1
00008c 2f20                          mov     ledstate, w
00008d b925                          out     PORTB, ledstate
00008e 9508                          ret
                                 
                                 ;-------------------------------------------------------------------
                                 ; get_delay — devuelve límite en r24:r25 según timeidx
                                 ;   0 ? 250ms  1 ? 500ms  2 ? 1000ms  3 ? 2000ms
                                 ;-------------------------------------------------------------------
                                 get_delay:
00008f 3050                          cpi     timeidx, 0
000090 f039                          breq    gd_250
000091 3051                          cpi     timeidx, 1
000092 f041                          breq    gd_500
000093 3052                          cpi     timeidx, 2
000094 f049                          breq    gd_1000
000095 ed80                          ldi     r24, low(2000)
000096 e097                          ldi     r25, high(2000)
000097 9508                          ret
                                 gd_250:
000098 ef8a                          ldi     r24, low(250)
000099 e090                          ldi     r25, high(250)
00009a 9508                          ret
                                 gd_500:
00009b ef84                          ldi     r24, low(500)
00009c e091                          ldi     r25, high(500)
00009d 9508                          ret
                                 gd_1000:
00009e ee88                          ldi     r24, low(1000)
00009f e093                          ldi     r25, high(1000)
0000a0 9508                          ret
                                 
                                 ;Like a main in C
                                 start:
0000a1 94f8                          cli
0000a2 ef0f                          ldi     w, low(RAMEND)
0000a3 bf0d                          out     SPL, w
0000a4 e008                          ldi     w, high(RAMEND)
0000a5 bf0e                          out     SPH, w
                                 
0000a6 940e 0046                     call    ini_ports
                                 
                                 	; Limpiar GPIOR0 (flags)
0000a8 ba1e                          out     GPIOR0, r1          ; r1 = 0 siempre en AVR por convenio
                                     
                                 	; Inicializar variables en SRAM
                                     
0000a9 e604                      	ldi     w, 100
0000aa 9300 0100                     sts     cnt_100ms, w       ; cnt_100ms arranca en 100
0000ac 2700                          clr     w
0000ad 9300 0101                     sts     cnt_hb,     w
0000af 9300 0102                     sts     cnt_hb+1,   w
0000b1 9300 0103                     sts     cnt_seq,    w
0000b3 9300 0104                     sts     cnt_seq+1,  w
0000b5 9300 0105                     sts     cnt_sw3,    w
0000b7 9300 0106                     sts     cnt_sw3+1,  w
0000b9 9300 0107                     sts     cnt_pulse,  w
0000bb 9300 0108                     sts     cnt_pulse+1,w
0000bd 9300 0109                     sts     ctr_val,    w
0000bf 9300 010a                     sts     ctr_pulse,  w
                                 
                                     ; Inicializar registros
0000c1 2722                          clr     ledstate
0000c2 e030                          ldi     sysstate, STATE_IDLE
0000c3 2744                          clr     pos
0000c4 e051                          ldi     timeidx, 1          ; tiempo inicial = 500ms
                                 
                                     ; Leer estado inicial de botones
0000c5 b169                          in      oldbtn, PIND
0000c6 736c                          andi    oldbtn, (1<<SW1)|(1<<SW2)|(1<<SW3)|(1<<SW4)
                                 
0000c7 940e 004f                     call    ini_timer1
0000c9 9478                          sei                         ; habilitar interrupciones globales
                                 
                                 ;-------------------------------------------------------------------
                                 ; LOOP PRINCIPAL
                                 ;-------------------------------------------------------------------
                                 loop:
                                     ;--- [1] Esperar flag_1ms (bit0 GPIOR0) -------------------------
0000ca 9bf0                          sbis    GPIOR0, BIT_1MS
0000cb cffe                          rjmp    loop
0000cc 98f0                          cbi     GPIOR0, BIT_1MS     ; consumir flag
                                  
                                     ;--- [2] Leer botones y detectar flancos -------------------------
0000cd b179                          in      newbtn, PIND
0000ce 737c                          andi    newbtn, (1<<SW1)|(1<<SW2)|(1<<SW3)|(1<<SW4)
                                  
                                     ; flancos descendentes (botón recién presionado)
0000cf 2f07                          mov     w, newbtn
0000d0 9500                          com     w
0000d1 2306                          and     w, oldbtn
                                  
                                     ; flancos ascendentes (botón recién soltado)
0000d2 2f16                          mov     w1, oldbtn
0000d3 9510                          com     w1
0000d4 2317                          and     w1, newbtn          ; w1 = flancos ascendentes
                                  
                                     ;--- [3] Manejar SW3 (lógica especial: corto vs largo) -----------
                                     ; Si SW3 está presionado ahora ? incrementar cnt_sw3
0000d5 2f87                          mov     r24, newbtn
0000d6 9580                          com     r24
0000d7 7180                          andi    r24, (1<<SW3)
0000d8 f091                          breq    sw3_not_held        ; SW3 no está presionado
                                  
                                     ; SW3 presionado: incrementar cnt_sw3 (saturar en SW3_LONG)
0000d9 91a0 0105                     lds     r26, cnt_sw3
0000db 91b0 0106                     lds     r27, cnt_sw3+1
0000dd ed80                          ldi     r24, low(SW3_LIMIT)
0000de e097                          ldi     r25, high(SW3_LIMIT)
0000df 17a8                          cp      r26, r24
0000e0 07b9                          cpc     r27, r25
0000e1 f049                          breq    sw3_not_held        ; ya llegó al límite, no incrementar más
0000e2 e081                          ldi     r24, 1
0000e3 0fa8                          add     r26, r24
0000e4 2788                          clr     r24
0000e5 1fb8                          adc     r27, r24
0000e6 93a0 0105                     sts     cnt_sw3,   r26
0000e8 93b0 0106                     sts     cnt_sw3+1, r27
0000ea c000                          rjmp    sw3_not_held
                                  
                                 sw3_not_held:
                                     ; Flanco ascendente en SW3 ? evaluar duración
0000eb ff14                          sbrs    w1, SW3
0000ec c02d                          rjmp    skip_sw3            ; no hubo flanco ascendente
                                  
0000ed 91a0 0105                     lds     r26, cnt_sw3
0000ef 91b0 0106                     lds     r27, cnt_sw3+1
                                  
                                     ; Resetear cnt_sw3
0000f1 2788                          clr     r24
0000f2 9380 0105                     sts     cnt_sw3,   r24
0000f4 9380 0106                     sts     cnt_sw3+1, r24
                                  
                                     ; ¿Fue pulsación larga? (? 2000ms)
0000f6 ed80                          ldi     r24, low(SW3_LIMIT)
0000f7 e097                          ldi     r25, high(SW3_LIMIT)
0000f8 17a8                          cp      r26, r24
0000f9 07b9                          cpc     r27, r25
0000fa f0a0                          brlo    sw3_short           ; fue corto
                                  
                                 sw3_long:
                                     ; Toggle modo COUNTER
0000fb 3033                          cpi     sysstate, STATE_COUNTER
0000fc f069                          breq    sw3_exit_counter
                                     ; Entrar a modo COUNTER
0000fd e033                          ldi     sysstate, STATE_COUNTER
0000fe 2700                          clr     w
0000ff 9300 0109                     sts     ctr_val,    w
000101 9300 010a                     sts     ctr_pulse,  w
000103 9300 0107                     sts     cnt_pulse,  w
000105 9300 0108                     sts     cnt_pulse+1,w
000107 940e 0067                     call    update_leds         ; apagar LEDs de secuencia
000109 c010                          rjmp    skip_sw3
                                 sw3_exit_counter:
                                     ; Salir de modo COUNTER ? IDLE
00010a e030                          ldi     sysstate, STATE_IDLE
00010b 2744                          clr     pos
00010c 940e 0067                     call    update_leds
00010e c00b                          rjmp    skip_sw3
                                  
                                 sw3_short:
                                     ; Pulsación corta: STOP (solo si no está en modo COUNTER)
00010f 3033                          cpi     sysstate, STATE_COUNTER
000110 f049                          breq    skip_sw3
000111 e030                          ldi     sysstate, STATE_IDLE
000112 2744                          clr     pos
000113 2700                          clr     w
000114 9300 0103                     sts     cnt_seq,   w
000116 9300 0104                     sts     cnt_seq+1, w
000118 940e 0067                     call    update_leds
                                  
                                 skip_sw3:
                                  
                                     ;--- [4] SW1 ? depende del modo ---------------------------------
00011a ff02                          sbrs    w, SW1
00011b c019                          rjmp    skip_sw1
                                  
00011c 3033                          cpi     sysstate, STATE_COUNTER
00011d f041                          breq    sw1_counter
                                  
                                     ; Modo normal: iniciar secuencia ascendente
00011e e031                          ldi     sysstate, STATE_UP
00011f 2744                          clr     pos
000120 2700                          clr     w
000121 9300 0103                     sts     cnt_seq,   w
000123 9300 0104                     sts     cnt_seq+1, w
000125 c00f                          rjmp    skip_sw1
                                  
                                 sw1_counter:
                                     ; Modo contador: incrementar ctr_val (0?5?0)
000126 9100 0109                     lds     w, ctr_val
000128 9503                          inc     w
000129 3006                          cpi     w, 6
00012a f008                          brlo    sw1_ctr_store
00012b 2700                          clr     w
                                 sw1_ctr_store:
00012c 9300 0109                     sts     ctr_val, w
                                     ; Reiniciar visualización
00012e 2700                          clr     w
00012f 9300 010a                     sts     ctr_pulse,  w
000131 9300 0107                     sts     cnt_pulse,  w
000133 9300 0108                     sts     cnt_pulse+1,w
                                  
                                 skip_sw1:
                                  
                                     ;--- [5] SW2 ? secuencia descendente (solo modo normal) ---------
000135 ff03                          sbrs    w, SW2
000136 c009                          rjmp    skip_sw2
000137 3033                          cpi     sysstate, STATE_COUNTER
000138 f039                          breq    skip_sw2
000139 e032                          ldi     sysstate, STATE_DOWN
00013a 2744                          clr     pos
00013b 2700                          clr     w
00013c 9300 0103                     sts     cnt_seq,   w
00013e 9300 0104                     sts     cnt_seq+1, w
                                 skip_sw2:
                                  
                                     ;--- [6] SW4 ? modificar tiempo (solo modo normal) --------------
000140 ff05                          sbrs    w, SW4
000141 c006                          rjmp    skip_sw4
000142 3033                          cpi     sysstate, STATE_COUNTER
000143 f021                          breq    skip_sw4
000144 9553                          inc     timeidx
000145 3054                          cpi     timeidx, 4
000146 f008                          brlo    skip_sw4
000147 2755                          clr     timeidx
                                 skip_sw4:
                                  
                                     ;--- [7] Guardar estado botones ----------------------------------
000148 2f67                          mov     oldbtn, newbtn
                                  
                                     ;--- [8] Lógica según estado del sistema -------------------------
000149 3033                          cpi     sysstate, STATE_COUNTER
00014a f109                          breq    do_counter
00014b 3030                          cpi     sysstate, STATE_IDLE
00014c f409                          brne    no_idle
00014d c05f                          rjmp    check_heartbeat
                                 no_idle:
                                  
                                     ; ?? SEQ_UP o SEQ_DOWN ??
00014e 91a0 0103                     lds     r26, cnt_seq
000150 91b0 0104                     lds     r27, cnt_seq+1
000152 e001                          ldi     w, 1
000153 0fa0                          add     r26, w
000154 2700                          clr     w
000155 1fb0                          adc     r27, w
000156 93a0 0103                     sts     cnt_seq,   r26
000158 93b0 0104                     sts     cnt_seq+1, r27
                                  
00015a 940e 008f                     call    get_delay
00015c 17a8                          cp      r26, r24
00015d 07b9                          cpc     r27, r25
00015e f408                          brsh    no_seq_wait
00015f c04d                          rjmp    check_heartbeat
                                 no_seq_wait:
                                  
000160 2700                          clr     w
000161 9300 0103                     sts     cnt_seq,   w
000163 9300 0104                     sts     cnt_seq+1, w
000165 9543                          inc     pos
000166 3045                          cpi     pos, 5
000167 f008                          brlo    seq_ok
000168 e041                          ldi     pos, 1
                                 seq_ok:
000169 940e 0067                     call    update_leds
00016b c041                          rjmp    check_heartbeat
                                  
                                     ; ?? MODO CONTADOR ??
                                     ; Visualización: N pulsos de 200ms ON / 200ms OFF
                                     ; Entre grupos: 500ms de pausa
                                     ; Si ctr_val == 0 ? todos apagados
                                 do_counter:
00016c 9100 0109                     lds     w, ctr_val
00016e 2300                          tst     w
00016f f1e9                          breq    check_heartbeat     ; valor 0 ? LEDs apagados, no hacer nada
                                  
                                     ; Incrementar cnt_pulse
000170 91a0 0107                     lds     r26, cnt_pulse
000172 91b0 0108                     lds     r27, cnt_pulse+1
000174 e001                          ldi     w, 1
000175 0fa0                          add     r26, w
000176 2700                          clr     w
000177 1fb0                          adc     r27, w
000178 93a0 0107                     sts     cnt_pulse,   r26
00017a 93b0 0108                     sts     cnt_pulse+1, r27
                                  
                                     ; Fase ON: 0..199ms ? LEDs encendidos
00017c ec88                          ldi     r24, low(200)
00017d e090                          ldi     r25, high(200)
00017e 17a8                          cp      r26, r24
00017f 07b9                          cpc     r27, r25
000180 f430                          brsh    ctr_check_off
                                     ; Encender todos los LEDs (preservar HB)
000181 2f02                          mov     w, ledstate
000182 7200                          andi    w, (1<<LEDBUILTIN)
000183 600f                          ori     w, (1<<LED1)|(1<<LED2)|(1<<LED3)|(1<<LED4)
000184 2f20                          mov     ledstate, w
000185 b925                          out     PORTB, ledstate
000186 c026                          rjmp    check_heartbeat
                                  
                                 ctr_check_off:
                                     ; Fase OFF: 200..399ms ? LEDs apagados
000187 e980                          ldi     r24, low(400)
000188 e091                          ldi     r25, high(400)
000189 17a8                          cp      r26, r24
00018a 07b9                          cpc     r27, r25
00018b f428                          brsh    ctr_next_pulse
                                     ; Apagar LEDs de secuencia (preservar HB)
00018c 2f02                          mov     w, ledstate
00018d 7200                          andi    w, (1<<LEDBUILTIN)
00018e 2f20                          mov     ledstate, w
00018f b925                          out     PORTB, ledstate
000190 c01c                          rjmp    check_heartbeat
                                  
                                 ctr_next_pulse:
                                     ; Terminó un ciclo ON/OFF de 400ms ? ver si hay más pulsos
000191 9100 010a                     lds     w, ctr_pulse
000193 9503                          inc     w
000194 9300 010a                     sts     ctr_pulse, w
000196 9180 0109                     lds     r24, ctr_val
000198 1708                          cp      w, r24
000199 f068                          brlo    ctr_restart_pulse   ; todavía quedan pulsos
                                  
                                     ; Terminaron todos los pulsos ? pausa de 500ms adicionales
                                     ; cnt_pulse sigue corriendo hasta 400+500=900ms
00019a e884                          ldi     r24, low(900)
00019b e093                          ldi     r25, high(900)
00019c 17a8                          cp      r26, r24
00019d 07b9                          cpc     r27, r25
00019e f070                          brlo    check_heartbeat     ; en pausa
                                  
                                     ; Fin de pausa ? reiniciar secuencia de pulsos
00019f 2700                          clr     w
0001a0 9300 010a                     sts     ctr_pulse,   w
0001a2 9300 0107                     sts     cnt_pulse,   w
0001a4 9300 0108                     sts     cnt_pulse+1, w
0001a6 c006                          rjmp    check_heartbeat
                                  
                                 ctr_restart_pulse:
                                     ; Reiniciar cnt_pulse para el siguiente pulso
0001a7 2700                          clr     w
0001a8 9300 0107                     sts     cnt_pulse,   w
0001aa 9300 0108                     sts     cnt_pulse+1, w
0001ac c000                          rjmp    check_heartbeat
                                  
                                     ;--- [9] Heartbeat (flag_100ms) ----------------------------------
                                     ; Modo normal:  1 flash de 100ms cada 3s
                                     ; Modo counter: 2 flashes rápidos cada 3s
                                 check_heartbeat:
0001ad 9bf1                          sbis    GPIOR0, BIT_100MS
0001ae cf1b                          rjmp    loop
0001af 98f1                          cbi     GPIOR0, BIT_100MS
                                  
0001b0 91a0 0101                     lds     r26, cnt_hb
0001b2 91b0 0102                     lds     r27, cnt_hb+1
0001b4 e001                          ldi     w, 1
0001b5 0fa0                          add     r26, w
0001b6 2700                          clr     w
0001b7 1fb0                          adc     r27, w
0001b8 93a0 0101                     sts     cnt_hb,   r26
0001ba 93b0 0102                     sts     cnt_hb+1, r27
                                  
0001bc 3033                          cpi     sysstate, STATE_COUNTER
0001bd f069                          breq    hb_counter
                                  
                                     ; ?? Heartbeat modo normal: 1 flash en t=0, apagar en t=1 ??
0001be 30a1                          cpi     r26, 1
0001bf f421                          brne    hb_check_off_normal
                                     ; Encender LEDBUILTIN
0001c0 e200                          ldi     w, (1<<LEDBUILTIN)
0001c1 2b20                          or      ledstate, w
0001c2 b925                          out     PORTB, ledstate
0001c3 c018                          rjmp    hb_check_reset
                                  
                                 hb_check_off_normal:
0001c4 30a2                          cpi     r26, 2
0001c5 f4b1                          brne    hb_check_reset
                                     ; Apagar LEDBUILTIN
0001c6 2f02                          mov     w, ledstate
0001c7 7d0f                          andi    w, ~(1<<LEDBUILTIN)
0001c8 2f20                          mov     ledstate, w
0001c9 b925                          out     PORTB, ledstate
0001ca c011                          rjmp    hb_check_reset
                                  
                                     ; ?? Heartbeat modo counter: 2 flashes (t=0 ON, t=1 OFF, t=2 ON, t=3 OFF) ??
                                 hb_counter:
0001cb 30a1                          cpi     r26, 1
0001cc f039                          breq    hb_on
0001cd 30a3                          cpi     r26, 3
0001ce f029                          breq    hb_on
0001cf 30a2                          cpi     r26, 2
0001d0 f039                          breq    hb_off
0001d1 30a4                          cpi     r26, 4
0001d2 f029                          breq    hb_off
0001d3 c008                          rjmp    hb_check_reset
                                  
                                 hb_on:
0001d4 e200                          ldi     w, (1<<LEDBUILTIN)
0001d5 2b20                          or      ledstate, w
0001d6 b925                          out     PORTB, ledstate
0001d7 c004                          rjmp    hb_check_reset
                                  
                                 hb_off:
0001d8 2f02                          mov     w, ledstate
0001d9 7d0f                          andi    w, ~(1<<LEDBUILTIN)
0001da 2f20                          mov     ledstate, w
0001db b925                          out     PORTB, ledstate
                                  
                                 hb_check_reset:
                                     ; Resetear cnt_hb cada 30 x 100ms = 3s
0001dc 31ae                          cpi     r26, HB_PERIOD
0001dd f408                          brsh    no_hb_reset
0001de ceeb                          rjmp    loop
                                 no_hb_reset:
0001df 2700                          clr     w
0001e0 9300 0101                     sts     cnt_hb,   w
0001e2 9300 0102                     sts     cnt_hb+1, w
                                  


